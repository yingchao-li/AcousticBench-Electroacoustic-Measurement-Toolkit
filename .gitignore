# ---------------------------------------------------------------------------
# AcousticBench .gitignore
# The raw dataset is NOT redistributed with this repository (see DATA_LICENSE.md
# and scripts/fetch_data.py). Place Data.mat / Documentation.pdf at the repo root
# locally; they are ignored by git.
# ---------------------------------------------------------------------------
Data.mat
Documentation.pdf
data/raw/
*.mat
!tests/fixtures/**/*.mat

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version
.cache/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Notebooks / IDE
.ipynb_checkpoints/
.idea/
.vscode/
*.swp
.DS_Store

# Logs / transient outputs
*.log
results/logs/
results/tmp/
reports/tmp/
matlab/**/*.asv
matlab/**/slprj/
matlab/**/*.autosave

# Generated experiment artefacts that are intentionally not versioned
results/**/*.nc
results/**/*.h5
results/**/*.wav
# large generated cross-language exchange file (regenerated by `acb validate`)
results/validation/matlab_inputs.mat
results/validation/matlab_reference.csv
